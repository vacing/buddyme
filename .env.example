# BuddyMe API Keys Configuration
# Copy this file to .env and fill in your actual keys

# ===================== 必需配置 =====================
# 至少配置一个大模型 API Key + 百度搜索 API Key

# 智谱GLM API Key (推荐，默认模型)
# 获取地址：https://open.bigmodel.cn/
GLM_API_KEY=

# DeepSeek API Key (高性能选项)
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 百度搜索 API Key (必需，网络搜索功能)
# 获取地址：https://console.bce.baidu.com/qianfan/ais/console/applicationConsole/application
BAIDU_SEARCH_API_KEY=

# ===================== 可选配置 =====================
# 以下模型可根据需要选择性配置

# 百度千帆ERNIE API Key
# 获取地址：https://console.bce.baidu.com/qianfan/
ERNIE_API_KEY=

# 小米MIMO API Key
# 获取地址：https://mimo.xiaomi.com/
XIAOMI_API_KEY=

# 阿里通义千问 API Key
# 获取地址：https://bailian.console.aliyun.com/
QWEN_API_KEY=
